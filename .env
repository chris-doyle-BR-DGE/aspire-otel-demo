# Image versions
ASPIRE_DASHBOARD_IMAGE=mcr.microsoft.com/dotnet/aspire-dashboard:9.5
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.139.0
TELEMETRYGEN_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:v0.139.0

# Host ports (offset from the OTLP defaults so they don't clash with a local collector)
ASPIRE_UI_PORT=18888
COLLECTOR_GRPC_PORT=14317
COLLECTOR_HTTP_PORT=14318
COLLECTOR_HEALTH_PORT=13134
